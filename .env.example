# Copy this file to .env and fill in your values.
#
# You need a Groq API key for real LLM calls. Groq's free tier
# (https://console.groq.com/) is enough to run this whole project at no
# cost. Without a key the app runs in DRY-RUN heuristic mode.

# --- Groq (free tier, OpenAI-compatible) -----------------------------------
# Get one at https://console.groq.com/keys. Model names occasionally change on
# Groq's end; check https://console.groq.com/docs/models if one 404s.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_PLANNER_MODEL=openai/gpt-oss-120b
GROQ_EXECUTOR_MODEL=openai/gpt-oss-20b
GROQ_VERIFIER_MODEL=openai/gpt-oss-120b

# Optional: an OpenAI-compatible local inference server (e.g. Ollama, vLLM,
# LM Studio) used as a genuinely degraded last-resort fallback when the
# circuit breaker trips on sustained failures from Groq. Leave blank to use the built-in heuristic fallback instead (no
# local model required to run the project).
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=

# Session cost budget (approx tokens) before the UI requires confirmation.
SESSION_TOKEN_BUDGET=200000
# Per-question hypothesis fan-out token budget.
QUESTION_TOKEN_BUDGET=20000

# Sandbox resource limits
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEMORY_MB=512

# Per-user rate limit (requests per minute)
RATE_LIMIT_PER_MINUTE=20
